  "item": [
    {
      "name": "1. GET All Books (Default Parameters)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is an array of books', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books/"
      }
    },
    {
      "name": "2. GET Books - Search by Title (search_q)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returned books match partial title 'Clean'\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "    jsonData.forEach(function(book) {",
              "        pm.expect(book.title.toLowerCase()).to.include('clean');",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books/?search_q=Clean"
      }
    },
    {
      "name": "3. GET Books - Sort by Price ASC",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Books are sorted in ascending order of price', function () {",
              "    var jsonData = pm.response.json();",
              "    for (var i = 1; i < jsonData.length; i++) {",
              "        pm.expect(jsonData[i].price).to.be.at.least(jsonData[i-1].price);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books/?order_by=price&order=ASC"
      }
    },
